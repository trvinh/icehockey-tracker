# Copy to .env (chmod 600). Never commit .env.
# Long random password for the API; enter the same value under Settings → Sync password on each device.
HOCKEY_TOKEN=
# Google Maps key with only the Routes API enabled (server-side: restrict by API, not by website).
GOOGLE_MAPS_KEY=
# Where the SQLite database lives on the host (keep it on a Linux filesystem, not exFAT).
HOCKEY_DATA_DIR=./data
HOCKEY_HOST_PORT=8090
